# Resend (contact form + newsletter)
# ─────────────────────────────────
# 1) Local: copy this file → .env.local
#       cp .env.example .env.local
# 2) Vercel: Project → Settings → Environment Variables
#    Add all three below to Production (and Preview if you want previews to send mail).
#
# Get your API key: https://resend.com/api-keys

RESEND_API_KEY=re_your_resend_api_key_here

# Where inbound notifications arrive (your inbox)
CONTACT_TO_EMAIL=tyresemuigai09@gmail.com

# Sender shown in inbox. MUST be allowed by Resend:
# • Production: verify your domain in Resend, then use e.g. "Kratos Systems <hello@yourdomain.com>"
# • Resend-only testing without a domain: use exactly the onboarding sender (restricted):
#       CONTACT_FROM_EMAIL="Kratos Systems <onboarding@resend.dev>"
#   and CONTACT_TO_EMAIL must be the email you use to log in to Resend.
CONTACT_FROM_EMAIL=Kratos Systems <onboarding@resend.dev>
